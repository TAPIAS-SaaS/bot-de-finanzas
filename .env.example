# ============================================================================
# BOT DE FINANZAS — CONFIGURACIÓN DE EJEMPLO (SIN SECRETOS REALES)
# Copie este archivo a .env para desarrollo local. Nunca suba .env a GitHub.
# ============================================================================

# Entorno y modo de operación (paper | demo | live)
# Por seguridad, el modo inicial es siempre 'paper' y 'ALLOW_LIVE_TRADING=false'
APP_ENV=development
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# Capital de referencia inicial y conversión contable
INITIAL_CAPITAL_COP=400000
REFERENCE_COP_PER_USDT=4200
PRIMARY_SYMBOL=BTC/USDT
CANDIDATE_SYMBOLS=BTC/USDT,ETH/USDT
ENTRY_TIMEFRAME=1h
TREND_TIMEFRAME=4h

# Límites deterministas del Gestor de Riesgo (RiskManager)
MAX_RISK_PER_TRADE=0.005
MAX_EXPOSURE=0.50
DAILY_LOSS_LIMIT=0.01
MAX_DRAWDOWN_LIMIT=0.05
MAX_CONCURRENT_POSITIONS=1
MIN_ORDER_NOTIONAL_USDT=5.0
DEFAULT_FEE_RATE=0.001
DEFAULT_SLIPPAGE_RATE=0.0005

# Pronósticos experimentales TimesFM
ENABLE_TIMESFM=false
TIMESFM_MODEL_VERSION=timesfm-2.5-200m
TIMESFM_HORIZON=12

# Asesor Gemini (ejecutado exclusivamente en el servidor)
ENABLE_GEMINI_ADVISOR=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MAX_CALLS_PER_HOUR=15

# Conexión opcional con Exchange (CCXT Spot únicamente, sin retiros ni margen)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Persistencia y conexión entre servidor Node.js y motor Python
SQLITE_DB_PATH=./data/bot_finanzas.sqlite
PYTHON_ENGINE_URL=http://127.0.0.1:8000
ADMIN_API_TOKEN=dev-local-admin-token-change-in-prod
APP_URL=http://localhost:3000
